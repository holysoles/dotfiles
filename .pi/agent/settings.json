{
  "lastChangelogVersion": "1.0.0",
  "theme": "dark",
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@twogiants/pi-anthropic-vertex",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-lens",
    "npm:pi-context-view"
  ],
  "enabledModels": [
    "openai/gpt-6-luna",
    "openai/gpt-6-sol",
    "openai/gpt-6-astra"
  ],
  "projectPrompts": [
    ".claude/commands"
  ],
  "projectSkills": [
    ".claude/skills"
  ],
  "env": {
    "GIT_EDITOR": "true"
  },
  "extensions": [
    "-builtin:mcp"
  ]
}
