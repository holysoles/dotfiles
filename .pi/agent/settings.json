{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "fallback",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "packages": [
    "npm:@plannotator/pi-extension",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-lens",
    "npm:pi-context-view"
  ],
  "enabledModels": [
    "fallback/gpt-6-sol",
    "fallback/gpt-6-luna",
    "fallback/gpt-6-astra",
    "fallback/gpt-5.6-terra",
    "enmaas/rits/zai-org/glm-5-3"
  ],
  "projectPrompts": [
    ".claude/commands"
  ],
  "projectSkills": [
    ".claude/skills"
  ],
  "env": {
    "GIT_EDITOR": "true"
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "model": "fallback/gpt-6-sol"
      }
    }
  }
}
