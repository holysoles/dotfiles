{
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny"
    },
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "export *": "allow",

      "cd *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "find *": "allow",
      "for *": "ask",
      "ls *": "allow",
      "wc -l": "allow",
      "tr": "allow",
      "grep *": "allow",
      "xargs grep": "allow",
      "rg *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "cat *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "curl *": "ask",
      "wget *": "ask",
      "jq *": "allow",
      "base64 *": "allow",
      "sed *": "allow",
      "sed -i *": "ask",
      "awk *": "allow",
      "awk -i *": "ask",

      "git *": "ask",
      "git log *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git ls-files *": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",
      "git remote -v": "allow",

      "kubectl *": "ask",
      "kubectl get *": "allow",
      "kubectl list *": "allow",
      "kubectl logs *": "allow",
      "oc *": "ask",
      "oc get *": "allow",
      "oc describe *": "allow",
      "oc list *": "allow",
      "oc logs *": "allow",
      "oc adm top *": "allow",
      "oc adm inspect *": "allow",
      "ocm *": "ask",
      "ocm get *": "ask",
      "ocm list *": "ask",
      
      "osdctl rhobs *": "allow",

      "rtk *": "allow",
      "rtk oc *": "ask",
      "rtk oc get *": "allow",
      "rtk oc describe *": "allow",
      "rtk oc list *": "allow",
      "rtk oc adm top *": "allow",
      "rtk kubectl *": "ask",
      "rtk pulumi *": "deny",

      "pd rest get *": "allow",
      "pd incident log *": "allow",
      "pd incident list *": "allow",
      "pd incident notes *": "ask",
      "pd incident alerts *": "allow",

      "pytest *": "allow",
      "ruff *": "allow",
      "black *": "allow",
      "prettier *": "allow",
      "eslint *": "allow",
      "gofmt *": "allow",
      "go vet *": "allow",
      "go test *": "allow",
      "cargo fmt *": "allow",
      "cargo check *": "allow",
      "cargo test *": "allow",
      "make": "allow",
      "make validate": "allow",
      "make lint": "allow",
      "make test": "allow",
      "make build": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/code/*": "allow",
      "/tmp/*": "allow",
      "/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/docs/*": "allow",
      "/incidents": "allow",
      "/incidents/*": "allow"
    }
  }
}
