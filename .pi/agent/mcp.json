{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/aws/mcp-proxy-for-aws@a5dd25e0ad99d0d874f2b779435b12b10932eae7",
        "mcp-proxy-for-aws",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--skip-auth",
        "--metadata",
        "INSTALL_SOURCE=agent-toolkit-core"
      ],
      "exposure": "codemode",
      "toolExposure": {
        "aws___get_presigned_url": "hidden",
        "aws___get_tasks": "hidden",
        "aws___run_script": "hidden",
        "aws___get_regional_availability": "hidden",
        "aws___list_regions": "hidden",
        "aws___search_documentation": "codemode",
        "aws___read_documentation": "codemode",
        "aws___retrieve_skill": "codemode"
      }
    }
  }
}
